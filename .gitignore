
cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Django
*.log
db.sqlite3
media/
staticfiles/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE and editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Build and distribution
build/
dist/
*.egg-info/

# Temporary files
*.tmp
*.bak
EOF
